# Copy this file to .env and fill in real values. Never commit .env itself.

# Required. Signs/verifies the JWT access tokens issued at login.
# The server refuses to start without this set (no hardcoded fallback).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Use a different value per environment
# (dev/staging/production) and rotate it if it's ever exposed - rotating
# invalidates every existing access token (users silently get a new one on
# their next request via the refresh-token flow) but does not affect
# already-issued refresh tokens.
JWT_SECRET=
